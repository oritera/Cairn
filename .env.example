# Copy this file to .env (git-ignored); docker compose reads it automatically.
#
# Shared secret that protects the Cairn console and API. The server requires it on every
# request and the dispatcher sends it as a bearer token. Use a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
CAIRN_AUTH_TOKEN=
